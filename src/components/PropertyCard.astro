---
// product Card Component - Modified for Lubricant Products
// Displays product information in a card format for listing pages

// https://lucide.dev/icons/

import { Droplets, Thermometer, Tag, Award } from '@lucide/astro';

/**
 * 产品卡片数据接口
 *
 * 注意：由于调用方来源不同，部分字段存在兼容性别名：
 * - zone (旧) / category (新)：主分类，优先取 zone，回退 category
 * - subcategory (旧) / subCategory (新)：子分类，优先取 subCategory，回退 subcategory
 */
interface ProductData {
  id?: string;
  title: string;
  description: string;
  keywords?: string;
  /** 主分类（lubricants 标准字段） */
  category?: string;
  brand?: string;
  series?: string;
  application?: string[];
  /** @deprecated 兼容旧 products 数据，新代码请用 category */
  zone?: string;
  /** 子分类（lubricants 标准字段，驼峰命名） */
  subCategory?: string;
  /** @deprecated 兼容旧映射代码，新代码请用 subCategory */
  subcategory?: string;
  image: string;
  images?: string[];
  featured: boolean;
  /** 原始 HTML 文件路径（仅用于数据迁移追溯） */
  originalFilePath?: string;
  /** 官方技术文档参考链接 */
  referenceUrl?: string;
}

/**
 * 产品卡片组件的属性接口
 * @property property - 包含id和data的产品对象
 */
interface Props {
  property: {
    id: string;
    data: ProductData;
  };
}

const { property } = Astro.props;

/**
 * 主分类：兼容旧 zone 字段和新 category 字段
 */
const mainCategory = property.data.zone || property.data.category || '';

/**
 * 子分类：兼容新 subCategory（驼峰）和旧 subcategory（全小写）
 */
const subCategory = property.data.subCategory || property.data.subcategory || '';

---

<!-- Product Card Component -->
<article data-property-slug={property.id} class="bg-white rounded-lg overflow-hidden elegant-shadow hover:elegant-shadow-lg transition-shadow duration-300">
  <!-- Image Section -->
  <div class="relative">
    <img
      src={property.data.image}
      alt={property.data.title}
      class="w-full h-48 md:h-56 object-cover"
      loading="lazy"
    />

    <!-- Featured Badge -->
    {property.data.featured && (
      <div class="absolute top-3 right-3 bg-accent-soft text-primary px-3 py-1 rounded-full text-xs font-medium">
        推荐
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="p-4">
    <!-- Title (Moved to top, removed price display) -->
    <h3 class="text-lg font-semibold text-neutral-dark mb-2">
      <a href={`/products/${property.id}`} class="hover:text-primary transition-colors">
        {property.data.title}
      </a>
    </h3>

    <!-- Product Specs - Updated for lubricant products -->
    <div class="flex items-center justify-between text-sm text-neutral-dark mb-3">

      <div class="flex items-center">
        <Award class="w-4 h-4 mr-1 text-primary-pale" />
        <span>{property.data.brand}</span>
      </div>

      <div class="flex items-center">
        <Tag class="w-4 h-4 mr-1 text-primary-pale" />
        <span>{mainCategory}</span>
      </div>

      <div class="flex items-center">
        <Droplets class="w-4 h-4 mr-1 text-primary-pale" />
        <span>{subCategory}</span>
      </div>

    </div>

    <!-- CTA Button -->
    <a
      href={`/products/${property.id}`}
      class="block w-full text-center bg-primary-soft text-primary-lightest py-2 rounded-sm hover:bg-primary transition-colors"
    >
      查看详情
    </a>
  </div>
</article>
