---
// Property Hero Component
// Specialized hero for property detail pages with key information

import type { CollectionEntry } from 'astro:content';

interface Props {
  property: CollectionEntry<'lubricants'>;
}

const { property } = Astro.props;

const getStatusBadgeClass = (status: string) => {
  switch (status) {
    case 'sold':
      return 'bg-red-100 text-red-800';
    case 'pending':
      return 'bg-yellow-100 text-yellow-800';
    default:
      return 'bg-primary-faint text-primary-dark';
  }
};
---

<!-- Property Hero Component -->
<section class="relative h-96 md:h-[32rem] overflow-hidden">
  <!-- Hero Image -->
  <img
    src={property.data.image}
    alt={property.data.title}
    class="w-full h-full object-cover"
    loading="eager"
  />

  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

  <!-- Product Information Overlay -->
  <div class="absolute bottom-0 left-0 right-0 text-white">
    <div class="container mx-auto px-4 py-8">
      <!-- Featured Badge -->
      <div class="flex items-center gap-3 mb-4">
        {property.data.featured && (
          <div class="bg-primary text-white px-3 py-1 rounded-full text-sm font-medium">
            Featured Product
          </div>
        )}
        <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
          {property.data.category}
        </div>
      </div>

      <!-- Product Title and Brand -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-2">
            {property.data.title}
          </h1>
          <div class="flex items-center text-white/90 mb-4">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/>
            </svg>
            <span class="text-lg">{property.data.brand}</span>
            {property.data.series && (
              <>
                <span class="mx-2">•</span>
                <span>{property.data.series}</span>
              </>
            )}
          </div>
        </div>

        <div class="text-right">
          {property.data.referenceUrl && (
            <a 
              href={property.data.referenceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-primary-pale hover:text-primary transition-colors"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0 0L10 14"/>
              </svg>
              View Technical Data
            </a>
          )}
        </div>
      </div>

      <!-- Key Product Details -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 pt-6 border-t border-white/20">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-9 9a1 1 0 01-1.414 0l-9-9A1 1 0 012 9V4a1 1 0 011-1h10a1 1 0 011 1v5.293l3.707-3.707a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <div class="text-lg font-semibold">Category</div>
            <div class="text-sm text-white/70">{property.data.category}</div>
          </div>
        </div>

        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
          </div>
          <div>
            <div class="text-lg font-semibold">Brand</div>
            <div class="text-sm text-white/70">{property.data.brand}</div>
          </div>
        </div>

        {property.data.application && property.data.application.length > 0 && (
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="text-lg font-semibold">Applications</div>
              <div class="text-sm text-white/70">{property.data.application.join(', ')}</div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>