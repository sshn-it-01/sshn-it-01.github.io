---
// 微信扫码联系组件
// 用于展示微信公众号和小程序二维码, 方便用户扫码关注
import { companyInfo } from '../data/company';
---

<!-- 微信扫码联系区域 -->
<!-- 小屏单列, 大屏双列布局 -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
  <!-- 微信公众号二维码 -->
  <div class="bg-white p-6 rounded-lg shadow-md text-center">
    <!-- 二维码图片 -->
    <img 
      src={companyInfo.qrcode.wechatOfficial} 
      alt="微信扫码关注公众号 - 华南森孚" 
      class="w-48 h-48 object-contain mx-auto mb-4"
    />
    <!-- 说明文字 -->
    <p class="text-base font-semibold text-neutral-dark mb-2">微信公众号</p>
    <!-- 提示 -->
    <p class="text-sm text-neutral-light">微信号: hnsf2011</p>
  </div>

  <!-- 微信小程序二维码 -->
  <div class="bg-white p-6 rounded-lg shadow-md text-center">
    <!-- 二维码图片 -->
    <img 
      src={companyInfo.qrcode.wechatMiniProgram} 
      alt="微信扫码进入小程序商城 - 华南森孚" 
      class="w-48 h-48 object-contain mx-auto mb-4"
    />
    <!-- 说明文字 -->
    <p class="text-base font-semibold text-neutral-dark mb-2">微信小程序商城</p>
    <!-- 提示 -->
    <p class="text-sm text-neutral-light">搜索"华南森孚小程序"</p>
  </div>
</div>

<!-- 提示文字 -->
<p class="text-sm text-neutral-light text-center mt-4">
  扫描二维码关注我们, 获取专业润滑油解决方案
</p>
