---
import '../styles/global.css'
import { companyInfo } from '../data/company';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: 'zh-CN' | 'en-US';
  meta?: {
    title?: string;
    description?: string;
    keywords?: string[];
  };
}

const {
  title,
  description = "佛山市华南森孚贸易有限公司——佛山专业润滑油供应商, 美孚 (Mobil) 首批授权经销商。主营工业润滑油、车用润滑油、特种润滑油, 提供润滑方案设计与技术支持。电话: 0757-87722666、13928559916 (何工)。",
  image = "/images/common/logo/华南_logo_彩色透明_180.png",
  canonical,
  locale = 'zh-CN',
  meta = {}
} = Astro.props;

const defaultKeywords = [
  '佛山润滑油',
  '佛山润滑油供应商',
  '华南森孚润滑油',
  '华南森孚',
  '美孚授权经销商',
  '佛山美孚经销商',
  '润滑油经销商',
  '工业润滑油',
  '液压油',
  '齿轮油',
  '发动机油',
  '润滑脂',
  '食品级润滑油',
  '商用车润滑油',
  '乘用车润滑油',
  '特种润滑油',
  '润滑方案',
  '润滑技术服务',
  '佛山润滑油厂家'
].join(', ');

// Use meta title if provided, otherwise fall back to title
const seoTitle = meta.title || title;
const seoDescription = meta.description || description;
const seoKeywords = meta.keywords?.filter(Boolean).join(', ') || defaultKeywords;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.hnsenfu.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const chineseUrl = locale === 'en-US' ? `${siteUrl}/` : canonicalUrl;
const englishUrl = locale === 'en-US' ? canonicalUrl : `${siteUrl}/en/`;
const isEnglish = locale === 'en-US';
const ogLocale = isEnglish ? 'en_US' : 'zh_CN';
// 未覆盖 image prop 时使用默认 logo 图 (180x180 PNG), 便于输出准确的尺寸元数据
const isLogoImage = Astro.props.image === undefined;
const logoUrl = `${siteUrl}/images/common/logo/华南_logo_彩色透明_180.png`;

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.hnsenfu.com/#localbusiness',
  name: companyInfo.name,
  url: 'https://www.hnsenfu.com',
  logo: {
    '@type': 'ImageObject',
    '@id': 'https://www.hnsenfu.com/#logo',
    url: logoUrl,
    contentUrl: logoUrl,
    width: 180,
    height: 180,
    caption: companyInfo.name,
    inLanguage: 'zh-CN'
  },
  telephone: [companyInfo.landline, companyInfo.phone],
  email: companyInfo.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'technical support',
    telephone: companyInfo.phone,
    availableLanguage: ['Chinese']
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: companyInfo.address,
    addressLocality: '佛山',
    addressRegion: '广东',
    postalCode: '528100',
    addressCountry: 'CN'
  },
  areaServed: ['佛山', '广东', '中国'],
  description: '佛山市华南森孚贸易有限公司成立于1991年, 是佛山地区专业润滑油供应商与美孚授权经销商。主营工业润滑油、车用润滑油、商用车润滑油、特种润滑油、食品级润滑油和润滑脂, 提供润滑方案设计、技术咨询和及时配送服务, 服务覆盖佛山、广州及华南地区。',
  keywords: ['佛山润滑油', '华南森孚', '美孚授权经销商', '润滑油供应商', '工业润滑油', '液压油', '齿轮油', '发动机油', '食品级润滑油'],
  sameAs: ['https://www.hnsenfu.com']
});

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: companyInfo.name,
  url: 'https://www.hnsenfu.com',
  description: '华南森孚——佛山专业润滑油供应商与美孚授权经销商官方网站。在线浏览工业润滑油、车用润滑油、商用车润滑油、特种润滑油和食品级润滑油产品, 获取润滑方案与技术咨询服务。',
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.hnsenfu.com/products',
    'query-input': 'required name=search_term'
  }
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={seoDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="author" content={companyInfo.name} />
    <meta name="theme-color" content="#0f3d6d" />
    <meta name="classification" content="润滑油, 润滑技术, 工业润滑, 车用润滑" />
    <meta name="geo.region" content="CN-GD" />
    <meta name="geo.placename" content="佛山" />
    <meta name="geo.position" content="23.16576;112.89828" />
    <meta name="ICBM" content="23.16576,112.89828" />
    <!-- Favicon / Icons: 多尺寸, 便于不同浏览器/搜索引擎识别 -->
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/images/common/logo/华南_logo_彩色白底_icon_48.ico" />
    <link rel="icon" type="image/x-icon" sizes="192x192" href="/images/common/logo/华南_logo_彩色白底_icon_192.ico" />
    <link rel="icon" type="image/x-icon" sizes="256x256" href="/images/common/logo/华南_logo_彩色白底_icon_256.ico" />
    <!-- Windows / Bing -->
    <meta name="msapplication-TileImage" content="/images/common/logo/华南_logo_彩色白底_icon_192.ico" />
    <meta name="msapplication-TileColor" content="#0f3d6d" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{seoTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="zh-Hans-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Keywords Meta Tag -->
    {seoKeywords && (
      <meta name="keywords" content={seoKeywords} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={companyInfo.name} />
    <meta property="og:locale" content={ogLocale} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content={seoTitle} />}
    {isLogoImage && <meta property="og:image:type" content="image/png" />}
    {isLogoImage && <meta property="og:image:width" content="180" />}
    {isLogoImage && <meta property="og:image:height" content="180" />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={seoTitle} />
    <meta property="twitter:description" content={seoDescription} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="article:tag" content="佛山润滑油, 美孚授权经销商, 工业润滑油, 液压油, 齿轮油" />
    {image && <meta property="twitter:image" content={image} />}
    {image && <meta property="twitter:image:alt" content={seoTitle} />}

    <script type="application/ld+json" set:html={organizationSchema} />
    <script type="application/ld+json" set:html={websiteSchema} />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation Header -->
    <header class="bg-white border-b border-primary-faint sticky top-0 z-50">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between gap-2 md:gap-4">
          <!-- Logo -->
          <a href={isEnglish ? '/en/' : '/'} class="flex items-center space-x-2 flex-shrink-0 min-w-0">
            <img
              src="/images/common/logo/华南_logo_彩色透明_180.png"
              alt="佛山市华南森孚贸易有限公司Logo——佛山专业润滑油供应商、美孚授权经销商"
              width={180}
              height={180}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="w-8 h-8 md:w-10 md:h-10 flex-shrink-0"
            />
            <span class={isEnglish ? 'text-sm sm:text-base md:text-lg font-semibold text-primary max-w-[calc(100vw-5rem)] truncate' : 'text-lg md:text-lg lg:text-xl font-semibold text-primary whitespace-nowrap truncate'}>{isEnglish ? companyInfo.nameEn : companyInfo.name}</span>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center space-x-8 flex-shrink-0">
            {isEnglish ? (
              <>
                <a href="/en/" class="text-neutral-dark hover:text-primary transition-colors">Home</a>
                <a href="/en/contact/" class="text-neutral-dark hover:text-primary transition-colors">Contact</a>
              </>
            ) : (
              <>
                <a href="/" class="text-neutral-dark hover:text-primary transition-colors">首页</a>
                <a href="/zones" class="text-neutral-dark hover:text-primary transition-colors">系列产品</a>
                <a href="/products" class="text-neutral-dark hover:text-primary transition-colors">所有产品</a>
                <a href="/news" class="text-neutral-dark hover:text-primary transition-colors">资讯中心</a>
                <a href="/about" class="text-neutral-dark hover:text-primary transition-colors">公司介绍</a>
              </>
            )}
            <a href={isEnglish ? '/en/contact/' : '/contact'} class="font-bold bg-accent text-primary-lightest px-4 py-2 rounded-sm hover:bg-primary transition-colors whitespace-nowrap">
              {isEnglish ? `Contact: ${companyInfo.email}` : `联系方式: ${companyInfo.landline}`}
            </a>
          </div>

          <!-- Mobile menu button -->
          <button id="mobile-menu-button" class="lg:hidden p-2 flex-shrink-0">
            <svg class="w-6 h-6 text-neutral-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden lg:hidden pt-4 pb-2">
          <div class="flex flex-col space-y-2">
            {isEnglish ? (
              <>
                <a href="/en/" class="text-neutral-dark hover:text-primary transition-colors py-2">Home</a>
                <a href="/en/contact/" class="text-neutral-dark hover:text-primary transition-colors py-2">Contact</a>
              </>
            ) : (
              <>
                <a href="/" class="text-neutral-dark hover:text-primary transition-colors py-2">首页</a>
                <a href="/zones" class="text-neutral-dark hover:text-primary transition-colors py-2">系列产品</a>
                <a href="/products" class="text-neutral-dark hover:text-primary transition-colors py-2">所有产品</a>
                <a href="/news" class="text-neutral-dark hover:text-primary transition-colors py-2">资讯中心</a>
                <a href="/about" class="text-neutral-dark hover:text-primary transition-colors py-2">公司介绍</a>
              </>
            )}
            <a href={isEnglish ? '/en/contact/' : '/contact'} class="font-bold bg-accent text-primary-lightest px-4 py-2 rounded-sm hover:bg-primary transition-colors whitespace-nowrap">
              {isEnglish ? `Contact: ${companyInfo.email}` : `联系方式: ${companyInfo.landline}`}
            </a>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-dark text-white py-12">
      <div class="container mx-auto px-4">
        <div class={isEnglish ? 'grid grid-cols-1 md:grid-cols-3 gap-10' : 'grid grid-cols-1 md:grid-cols-4 gap-8'}>
          <!-- Company Info -->
          <div class="col-span-1 md:col-span-1">
            <h3 class="text-white font-semibold mb-4">{isEnglish ? 'Quick links' : '快速导航'}</h3>
            <ul class="space-y-2 text-sm">
              {isEnglish ? (
                <>
                  <li><a href="/en/" class="text-neutral-light hover:text-primary-pale transition-colors">Home</a></li>
                  <li><a href="/en/contact/" class="text-neutral-light hover:text-primary-pale transition-colors">Contact</a></li>
                </>
              ) : (
                <>
                  <li><a href="/" class="text-neutral-light hover:text-primary-pale transition-colors">首页</a></li>
                  <li><a href="/products" class="text-neutral-light hover:text-primary-pale transition-colors">所有产品</a></li>
                  <li><a href="/news" class="text-neutral-light hover:text-primary-pale transition-colors">资讯中心</a></li>
                  <li><a href="/agents" class="text-neutral-light hover:text-primary-pale transition-colors">专业团队</a></li>
                  <li><a href="/about" class="text-neutral-light hover:text-primary-pale transition-colors">公司介绍</a></li>
                  <li><a href="/contact" class="text-neutral-light hover:text-primary-pale transition-colors">联系方式</a></li>
                  <li><a href="/navigation" class="text-neutral-light hover:text-primary-pale transition-colors">门店导航</a></li>
                </>
              )}
            </ul>
          </div>

          <!-- Product Categories -->
          {!isEnglish && <div>
            <h3 class="text-white font-semibold mb-4">{isEnglish ? 'Product focus' : '系列产品'}</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={isEnglish ? '/en/' : '/zones/industrial-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'Industrial lubricants' : '工业润滑油'}</a></li>
              <li><a href={isEnglish ? '/en/' : '/zones/passenger-car-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'Passenger car lubricants' : '乘用车润滑油'}</a></li>
              <li><a href={isEnglish ? '/en/' : '/zones/commercial-vehicle-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'Commercial vehicle lubricants' : '商用车润滑油'}</a></li>
              <li><a href={isEnglish ? '/en/' : '/zones/specialty-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'Specialty lubricants' : '特种润滑油'}</a></li>
              <li><a href={isEnglish ? '/en/' : '/zones/mobil-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'Mobil lubricants' : '美孚润滑油'}</a></li>
              <li><a href={isEnglish ? '/en/' : '/zones/apex-lubricants'} class="text-neutral-light hover:text-primary-pale transition-colors">{isEnglish ? 'APEX lubricants' : 'APEX阿帕克斯润滑油'}</a></li>
            </ul>
          </div>}

          <!-- Contact -->
          <div>
            <h3 class="text-white font-semibold mb-4">{isEnglish ? 'Contact' : '联系我们'}</h3>
            <ul class="space-y-2 text-sm text-neutral-light">
              <li>
                <strong class="text-white">{isEnglish ? 'Hours: ' : '工作时间: '}</strong>
                <span>{isEnglish ? companyInfo.workHoursEn : companyInfo.workHours}</span>
              </li>
              <li>
                <strong class="text-white">{isEnglish ? 'Landline: ' : '联系电话: '}</strong>
                <span>{isEnglish ? companyInfo.landlineEn : companyInfo.landline}</span>
              </li>
              <li>
                <strong class="text-white">{isEnglish ? 'Email: ' : '邮箱: '}</strong>
                <span>{companyInfo.email}</span>
              </li>
              <li>
                <strong class="text-white">{isEnglish ? 'Address: ' : '地址: '}</strong>
                <span>{isEnglish ? `${companyInfo.addressEn}, Foshan, Guangdong` : companyInfo.address}</span>
              </li>
            </ul>
          </div>

          <!-- Follow Us -->
          <div>
            <h3 class="text-white font-semibold mb-4">{isEnglish ? 'Stay connected' : '关注我们'}</h3>
            <p class="text-neutral-light text-sm leading-relaxed mb-4">
              {isEnglish ? 'Follow our latest product updates and service news.' : '关注我们的微信公众号和小程序'}
              {!isEnglish && <><br />获取最新产品信息和优惠活动</>}
            </p>
            <div class="flex space-x-4">
              <a
                href="https://mp.weixin.qq.com/s/kJLaFn0DHMpW_W8p1nikLA"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex hover:opacity-90 transition-opacity"
                aria-label={isEnglish ? 'Open Huanan Senfu official WeChat account' : '点击查看华南森孚微信公众号'}
              >
                <img 
                  src={companyInfo.qrcode.wechatOfficial} 
                  alt={isEnglish ? 'QR code for the official Huanan Senfu WeChat account' : '微信公众号二维码'}
                  title={isEnglish ? 'Official WeChat account' : '微信公众号'}
                  class="w-20 h-20 bg-white rounded object-contain"
                  loading="lazy"
                />
              </a>
              <a
                href="https://s.t9ii.cn/m/kXCW27"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex hover:opacity-90 transition-opacity"
                aria-label={isEnglish ? 'Open the Huanan Senfu WeChat store' : '点击进入华南森孚微信小程序商城'}
              >
                <img 
                  src={companyInfo.qrcode.wechatMiniProgram} 
                  alt={isEnglish ? 'QR code for the Huanan Senfu WeChat store' : '微信小程序二维码'}
                  title={isEnglish ? 'WeChat store' : '微信小程序'}
                  class="w-20 h-20 bg-white rounded object-contain"
                  loading="lazy"
                />
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-neutral-700 mt-8 pt-8 text-center text-sm text-neutral-light">
          <p>{isEnglish ? 'Copyright' : '版权所有'} &copy; <span id="current-year">{new Date().getFullYear()}</span> {isEnglish ? companyInfo.nameEn : companyInfo.name} {!isEnglish && <a href={companyInfo.icpURL} target="_blank" rel="noopener noreferrer" class="hover:text-primary-pale transition-colors">{companyInfo.icpNumber}</a>}</p>
          <div class="mt-2 space-x-4">
            <a href="/" class="hover:text-primary-pale transition-colors" lang="zh-CN">中文</a>
            <span>|</span>
            <a href="/en/" class="hover:text-primary-pale transition-colors" lang="en">English</a>
            <span>|</span>
            <a href={isEnglish ? '/en/' : '/copyright'} class="hover:text-primary-pale transition-colors">{isEnglish ? 'Legal notice' : '版权声明'}</a>
            <span>|</span>
            <a href={isEnglish ? '/en/' : '/disclaimer'} class="hover:text-primary-pale transition-colors">{isEnglish ? 'Disclaimer' : '免责声明'}</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');

      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>    