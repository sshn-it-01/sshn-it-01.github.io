---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import StoreCard from '../components/StoreCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import HeroSecondary from '../components/HeroSecondary.astro';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  return agents.map((agent) => ({
    params: { slug: agent.id },
    props: { agent }
  }));
}

// Get all agents for the page
const agents = await getCollection('agents');

// Get all stores from content collection
const stores = await getCollection('stores');

// Filter featured stores or use all stores
const displayedStores = stores.filter(store => store.data.featured);
---

<Layout
  title="华南森孚专业技术团队 | 佛山润滑油专家与技术支持"
  description="华南森孚拥有经验丰富的润滑技术专家团队, 为佛山及华南地区客户提供工业润滑油、车用润滑油、特种润滑油与润滑方案技术支持。"
  meta={{ keywords: ['佛山润滑油专家','润滑技术专家','润滑油技术支持','工业润滑油专家','车用润滑油咨询','华南森孚团队'] }}
>
  <!-- Hero Section -->
  <HeroSecondary 
    title="我们的专业技术团队"
    subtitle="华南森孚拥有一支经验丰富的润滑技术专家团队, 深耕行业三十余年。凭借深厚的技术积累和对美孚等品牌产品的专业理解, 我们为客户提供定制化的润滑解决方案。"
    alignment="left"
    backgroundStyle="gradient"
  />

  <!-- Stats Section -->
  <section class="py-12 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-dark mb-2">10+</div>
          <div class="text-sm text-neutral-dark font-medium">合作品牌</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-dark mb-2">30+</div>
          <div class="text-sm text-neutral-dark font-medium">年行业经验</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-dark mb-2">500+</div>
          <div class="text-sm text-neutral-dark font-medium">服务企业客户</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-dark mb-2">200+</div>
          <div class="text-sm text-neutral-dark font-medium">产品系列</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Agents Grid Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary-dark mb-4">
          润滑技术专家团队
        </h2>
        <p class="text-neutral max-w-2xl mx-auto">
          每位专家在特定领域拥有深厚技术积累, 为您的设备提供专业润滑保障
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16" id="agents-grid">
        {agents.map((agent) => (
          <AgentCard
            agent={agent.data}
            selected={false}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Stores Section -->
  <section class="py-16 bg-primary-faint">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary-dark mb-4">
          我们的门店
        </h2>
        <p class="text-neutral max-w-2xl mx-auto">
          多家门店为您提供便捷的润滑油采购和专业咨询服务
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {displayedStores.map((store) => (
          <StoreCard store={store.data} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary-dark mb-4">
          为什么选择华南森孚？
        </h2>
        <p class="text-neutral max-w-2xl mx-auto">
          专业润滑解决方案提供商, 为您的设备保驾护航
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-dark mb-3">品质保证</h3>
          <p class="text-neutral-dark">
            代理美孚等国际知名品牌, 提供正品保障, 确保产品质量可靠
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-dark mb-3">专业服务</h3>
          <p class="text-neutral-dark">
            专业技术团队提供定制化润滑方案, 满足不同行业应用需求
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-dark mb-3">丰富经验</h3>
          <p class="text-neutral-dark">
            多年行业深耕, 服务众多企业客户, 赢得良好口碑与信赖
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
