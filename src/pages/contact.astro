---
import Layout from '../layouts/Layout.astro';
import HeroSecondary from '../components/HeroSecondary.astro';
import ContactInfo from '../components/ContactInfo.astro';
import WeChatQR from '../components/WeChatQR.astro';
import { getEntry } from 'astro:content';

const store = await getEntry('stores', 'jianbei-store');
const storeName = store?.data.name || '华南森孚健北店';
const storeAddress = store?.data.address || '佛山市三水区西南街健力宝北路10号';
---

<Layout
  title="联系华南森孚 | 佛山润滑油采购与技术咨询热线"
  description="联系佛山市华南森孚贸易有限公司, 获取佛山本地润滑油、工业润滑油、商用车润滑油、乘用车润滑油、特种润滑油和技术咨询服务。电话: 0757-87722666。"
  meta={{ keywords: ['佛山润滑油采购','华南森孚润滑油','美孚授权经销商','润滑油咨询','润滑油技术支持'] }}
>
  <!-- Hero Section -->
  <HeroSecondary
    title="联系我们"
    subtitle="欢迎垂询, 我们将竭诚为您服务"
    height="h-56"
    alignment="left"
    backgroundImage=""
    backgroundStyle="image"
  />

  <!-- Map Section (Full Width) -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-3xl font-bold text-primary-dark">公司位置</h2>
          <a
            href="/navigation/jianbei-store"
            class="inline-flex items-center gap-2 rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white shadow-lg transition hover:bg-primary-800"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 100-4 3 3 0 000 4z"/>
            </svg>
            选择其他地图导航
          </a>
        </div>

        <div class="rounded-lg overflow-hidden elegant-shadow relative">
          <iframe
            title="华南森孚健北店百度地图"
            src={store?.data.baiduMapLink || 'https://j.map.baidu.com/48/9-lJ'}
            class="w-full h-[400px] border-0"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>

        <div class="mt-4 flex items-center justify-center space-x-6 text-sm text-neutral-light">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-primary-700" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <span>{storeAddress}</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-primary-700" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            <span>{store?.data.hours || '周一至周日 08:00-18:00'}</span>
          </div>
        </div>
        <p class="text-center text-neutral-light mt-4 text-lg">
          欢迎访问我们的门店, 获取专业的润滑油解决方案和服务。
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content with QR Codes -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">

        <!-- Two-column layout: Left contact info, Right WeChat QR codes -->
        <!-- Mobile: vertical stack, Desktop: side by side -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <!-- Left: Contact Information -->
          <div>
            <ContactInfo />
          </div>

          <!-- Right: WeChat QR Codes Section -->
          <div>
            <h3 class="text-2xl font-bold text-neutral-dark mb-6 text-center lg:text-left">关注我们</h3>
            <WeChatQR />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>