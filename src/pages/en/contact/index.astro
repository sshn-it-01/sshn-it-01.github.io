---
import Layout from '../../../layouts/Layout.astro';
import HeroSecondary from '../../../components/HeroSecondary.astro';
import { companyInfo } from '../../../data/company';
import { getEntry } from 'astro:content';
const store = await getEntry('stores', 'jianbei-store');
const storeAddress = store?.data.address || companyInfo.addressEn;
const mapSrc = store?.data.baiduMapCardLink || 'https://j.map.baidu.com/48/9-lJ';
const landlineHref = companyInfo.landlineEn.replace(' 0', ' ').replaceAll(' ', '');
const mobileHref = companyInfo.phoneEn.replace(/\s*\(.*\)$/, '').replaceAll(' ', '');
---

<Layout
  locale="en-US"
  title="Contact Huanan Senfu | Foshan Lubricant Supplier"
  description="Contact Foshan Huanan Senfu Trading Co., Ltd. for industrial lubricants, automotive lubricants, specialty products and technical support in South China."
  canonical="https://www.hnsenfu.com/en/contact/"
  meta={{ keywords: ['contact lubricant supplier China', 'Foshan lubricant supplier', 'Mobil distributor contact', 'industrial lubricant enquiry'] }}
>
  <HeroSecondary
    title="Contact us"
    subtitle="Visit our Foshan office for professional lubrication solutions and product support."
    height="h-56"
    alignment="left"
    backgroundImage=""
    backgroundStyle="image"
  />

  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-3xl font-bold text-primary-dark">Company location</h2>
          <a href="/en/navigation/jianbei-store" class="inline-flex items-center gap-2 rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white shadow-lg transition hover:bg-primary-800">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 100-4 3 3 0 000 4z"/>
            </svg>
            Find a store
          </a>
        </div>
        <div class="rounded-lg overflow-hidden elegant-shadow relative">
          <iframe id="store-map-iframe" title="Huanan Senfu location map" src={mapSrc} class="w-full h-[400px] border-0" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div id="store-map-fallback" class="hidden absolute inset-0 z-10 flex-col items-center justify-center" role="alert">
            <img src="/maps/map_foshan_sanshui.webp" alt="Map showing the Huanan Senfu location" class="absolute inset-0 w-full h-full object-cover" />
            <div class="relative z-10 flex flex-col items-center gap-3 bg-black/40 px-6 py-5 text-center">
              <p class="text-sm text-white">The map could not be loaded. Please refresh or open the map in a new window.</p>
              <div class="flex flex-wrap items-center justify-center gap-3">
                <button type="button" id="store-map-retry" class="inline-flex items-center gap-1 rounded-full bg-primary-700 px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-primary-800" onclick="location.href=location.pathname+'?force='+Date.now()">Refresh map</button>
                <a href={mapSrc} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary-800 transition hover:bg-neutral-100">Open map</a>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-neutral-light">
          <span>{storeAddress}, Foshan, Guangdong, China</span>
          <span>{store?.data.hours || companyInfo.workHoursEn}</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const iframe = document.getElementById('store-map-iframe') as HTMLIFrameElement;
      const fallback = document.getElementById('store-map-fallback') as HTMLElement;
      if (!iframe || !fallback) return;
      let loaded = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      iframe.addEventListener('load', function () {
        if (iframe.getAttribute('src') === 'about:blank') return;
        loaded = true;
        if (timer) clearTimeout(timer);
        fallback.classList.add('hidden');
        fallback.classList.remove('flex');
      });
      timer = setTimeout(() => {
        if (!loaded) {
          fallback.classList.remove('hidden');
          fallback.classList.add('flex');
        }
      }, 6000);
    })();
  </script>

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent-600">Contact details</p>
          <h2 class="text-3xl font-bold text-primary-900 md:text-4xl">A direct line to our local team.</h2>
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-neutral-700">
            <p><strong class="text-primary-900">Company:</strong> {companyInfo.nameEn}</p>
            <p><strong class="text-primary-900">Address:</strong> {companyInfo.addressEn}, Foshan, Guangdong, China</p>
            <p><strong class="text-primary-900">Landline:</strong> <a href={`tel:${landlineHref}`} class="text-primary-700 hover:text-accent-700">{companyInfo.landlineEn}</a></p>
            <p><strong class="text-primary-900">Mobile:</strong> <a href={`tel:${mobileHref}`} class="text-primary-700 hover:text-accent-700">{companyInfo.phoneEn}</a></p>
            <p><strong class="text-primary-900">Email:</strong> <a href={`mailto:${companyInfo.email}`} class="text-primary-700 hover:text-accent-700">{companyInfo.email}</a></p>
            <p><strong class="text-primary-900">Business hours:</strong> {companyInfo.workHoursEn}</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={`tel:${landlineHref}`} class="bg-accent-600 px-5 py-3 font-semibold text-white transition hover:bg-accent-700">Call our team</a>
            <a href={`mailto:${companyInfo.email}`} class="border border-primary-800 px-5 py-3 font-semibold text-primary-800 transition hover:bg-primary-800 hover:text-white">Send an email</a>
          </div>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-neutral-dark mb-6 text-center lg:text-left">Stay connected</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <div class="bg-white p-6 rounded-lg shadow-md text-center">
              <a href="https://mp.weixin.qq.com/s/kJLaFn0DHMpW_W8p1nikLA" target="_blank" rel="noopener noreferrer" class="block hover:opacity-90 transition-opacity" aria-label="Open the official Huanan Senfu WeChat account">
                <img src={companyInfo.qrcode.wechatOfficial} alt="QR code for the official Huanan Senfu WeChat account" class="w-48 h-48 object-contain mx-auto mb-4" />
                <p class="text-base font-semibold text-neutral-dark mb-2">Official WeChat account</p>
                <p class="text-sm text-neutral-light">WeChat ID: hnsf2011</p>
              </a>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md text-center">
              <a href="https://s.t9ii.cn/m/kXCW27" target="_blank" rel="noopener noreferrer" class="block hover:opacity-90 transition-opacity" aria-label="Open the Huanan Senfu WeChat store">
                <img src={companyInfo.qrcode.wechatMiniProgram} alt="QR code for the Huanan Senfu WeChat store" class="w-48 h-48 object-contain mx-auto mb-4" />
                <p class="text-base font-semibold text-neutral-dark mb-2">Huanan Senfu store</p>
                <p class="text-sm text-neutral-light">Scan or click to open the store</p>
              </a>
            </div>
          </div>
          <p class="text-sm text-neutral-light text-center mt-4">Follow us for professional lubricant solutions and product updates.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>