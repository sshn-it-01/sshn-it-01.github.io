---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';

// Get featured lubricants and zones
const featuredLubricants = await getCollection('lubricants', (entry) => entry.data.featured);
const allLubricants = await getCollection('lubricants');
const allZones = await getCollection('zones');

// 定义zones的显示顺序
const zoneOrder = [
  'industrial-lubricants',      // 工业润滑油
  'passenger-car-lubricants',   // 乘用车润滑油
  'commercial-vehicle-lubricants', // 商用车润滑油
  'specialty-lubricants',       // 特种润滑油
  'mobil-lubricants',           // 美孚润滑油
  'apex-lubricants'       // apex润滑油
];

// 按照指定顺序排序zones
const zones = allZones.sort((a, b) => {
  const indexA = zoneOrder.indexOf(a.id);
  const indexB = zoneOrder.indexOf(b.id);
  // 如果在order数组中找不到, 放到最后
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

// Limit featured lubricants to 6 for homepage
const homeFeaturedLubricants = featuredLubricants.slice(0, 6);

// If no featured products, show first 6 products
const displayProducts = homeFeaturedLubricants.length > 0 ? homeFeaturedLubricants : allLubricants.slice(0, 6);

// Sort products by brand name
const sortedProducts = [...displayProducts].sort((a, b) => {
  const brandA = a.data.brand || '美孚';
  const brandB = b.data.brand || '';
  return brandA.localeCompare(brandB, 'zh-CN');
});

// Randomize the display order of products
// const randomizedProducts = [...displayProducts].sort(() => Math.random() - 0.5);

// Get unique categories from lubricants
const availableCategories = [...new Set(allLubricants.map(p => p.data.category))];
---

<Layout
  title="华南森孚润滑油 | 佛山专业润滑油供应商-美孚授权经销商"
  description="佛山市华南森孚贸易有限公司, 成立于1991年, 是佛山本地专业润滑油供应商及美孚 (Mobil) 首批授权经销商。提供工业润滑油、商用车润滑油、乘用车润滑油、特种润滑油及润滑方案设计服务。电话: 0757-87722666。"
  meta={{ keywords: ['佛山润滑油供应商','华南森孚','美孚授权经销商','工业润滑油','商用车润滑油','乘用车润滑油','特种润滑油','润滑脂','佛山美孚经销商'] }}
>
  <!-- Hero Section -->
  <Hero
    title="专业润滑方案, 助力设备高效运行"
    subtitle="佛山本地专业润滑油供应商, 深耕行业三十余年。为汽车制造、工程机械、工厂设备及食品生产等领域, 提供高品质润滑油产品与专业技术服务。"
    image="/images/common/unsplash_maksym-kaharlytskyi-u13zBF4r56A.webp"
    height="full"
    alignment="center"
    ctaText="关于我们"
    ctaLink="/about"
    showSecondaryCta={true}
    secondaryCtaText="联系我们"
    secondaryCtaLink="/contact"
  />

  <!-- Featured Products Section -->
  <section id="featured" class="py-16 bg-primary-faint">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary-dark mb-4">
          核心产品推荐
        </h2>
        <p class="text-lg text-neutral max-w-2xl mx-auto">
          精选美孚、长城、APEX等优质品牌润滑油, 覆盖工业设备、商用车辆、乘用车辆及特种工况, 满足各类润滑需求。
        </p>
      </div>

      {sortedProducts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedProducts.map((product) => (
            <PropertyCard property={product} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-neutral-light">暂无产品展示。</p>
        </div>
      )}

      <div class="text-center mt-8">
        <a
          href="/products"
          class="inline-flex items-center bg-primary-soft text-primary-lightest px-6 py-3 rounded-sm hover:bg-primary transition-colors font-medium"
        >
          查看全部产品
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Product Categories Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary-dark mb-4">
          产品系列
        </h2>
        <p class="text-lg text-neutral max-w-2xl mx-auto">
          六大产品线全面覆盖工业设备、商用车辆、乘用车辆及特殊工况的润滑需求, 提供一站式润滑解决方案。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {zones.slice(0, 6).map((zone) => (
          <a
            href={`/zones/${zone.id}`}
            class="group block"
          >
            <div class="relative overflow-hidden rounded-lg elegant-shadow group-hover:elegant-shadow-lg transition-all duration-300">
              <img
                src={zone.data.image}
                alt={zone.data.title}
                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                <h3 class="text-xl font-semibold mb-2">{zone.data.title}</h3>
                <p class="text-white/90 text-sm line-clamp-2">{zone.data.description}</p>
              </div>
            </div>
            <span class="block mt-4 text-center text-primary group-hover:text-primary-soft transition-colors font-medium">
              点击了解更多 →
            </span>
          </a>
        ))}
        
      </div>

      <div class="text-center mt-12">
        <a
          href="/zones"
          class="inline-flex items-center border-2 border-primary text-primary px-6 py-3 rounded-sm hover:bg-primary hover:text-white transition-colors font-medium"
        >
          浏览所有分类
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Value Proposition Section -->
  <section class="py-16 bg-neutral-dark text-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-pale rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary-dark" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">三十余年行业经验</h3>
          <p class="text-neutral-light">
            成立于1991年, 深耕润滑行业三十五载, 专业技术团队为您提供可靠的润滑解决方案和现场技术支持。
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary-pale rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary-dark" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">正品品质保障</h3>
          <p class="text-neutral-light">
            美孚润滑油首批授权经销商, 严格质量管控, 国际认证标准, 确保每一件产品均符合原厂品质要求。
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary-pale rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary-dark" fill="currentColor" viewBox="0 0 20 20">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">本地专业服务</h3>
          <p class="text-neutral-light">
            佛山本地仓储配送, 及时响应客户需求。提供润滑方案设计、技术咨询及上门服务, 覆盖佛山、广州及珠三角地区。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <CallToAction
    title="寻找适合您的润滑解决方案？"
    subtitle="我们的专业技术团队将根据您的设备类型和工况要求, 推荐合适的产品并制定科学的用油方案, 帮助您降低综合润滑成本。"
  />
</Layout>