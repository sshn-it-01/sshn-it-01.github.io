---
import Layout from '../../layouts/Layout.astro';
import HeroSecondary from '../../components/HeroSecondary.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stores = await getCollection('stores');
  return stores.map((store) => ({
    params: { storeId: store.data['store-id'] },
    props: { store }
  }));
}

const { store } = Astro.props;
const storeData = store.data;

const mapPlatforms = [
  {
    key: 'amap',
    label: '高德地图',
    hrefKey: 'amapLink',
    icon: 'data:image/png;base64,'
  },
  {
    key: 'tencent',
    label: '腾讯地图',
    hrefKey: 'tencentMapLink',
    icon: 'data:image/png;base64,'
  },
  {
    key: 'baidu',
    label: '百度地图',
    hrefKey: 'baiduMapLink',
    icon: 'data:image/png;base64,'
  },
  {
    key: 'google',
    label: 'Google 地图',
    hrefKey: 'googleMapLink',
    icon: 'data:image/png;base64,',
  }
];
---

<Layout
  title={`${storeData.name}导航 | 华南森孚门店导航`}
  description={`${storeData.name}地图导航——支持高德地图、百度地图、腾讯地图及Google地图一键导航。地址: ${storeData.address}。电话：${storeData.phone}、13928559916 (何工)。`}
  meta={{ keywords: ['地图导航','门店导航', storeData.name, '佛山润滑油门店', '三水润滑油'] }}
>
  <HeroSecondary
    title={storeData.name}
    subtitle={`地址: ${storeData.address}`}
    height="h-72"
    alignment="left"
    backgroundStyle="gradient"
  />

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-primary-dark mb-4">选择地图应用导航</h2>
          <p class="text-neutral-dark">
            前往 <span class="font-semibold text-primary-dark">{storeData.name}</span>, 点击下方选择您常用的地图应用开始导航
          </p>
        </div>

        <div class="space-y-4">
          {mapPlatforms.map((platform) => {
            const href = storeData[platform.hrefKey as keyof typeof storeData] as string | undefined;
            if (!href) return null;

            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between w-full rounded-lg border border-primary-faint bg-neutral-50 px-5 py-4 text-left transition hover:border-primary hover:shadow-sm"
              >
                <span class="flex items-center gap-3">
                  <span class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full text-lg font-bold text-white">
                    {platform.icon.startsWith('data:image') ? (
                      <img src={platform.icon} alt={platform.label} class="h-full w-full object-cover" />
                    ) : (
                      platform.icon
                    )}
                  </span>
                  <span>
                    <span class="block font-semibold text-primary-dark">{platform.label}</span>
                  </span>
                </span>
                <span class="text-primary font-medium">打开</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
